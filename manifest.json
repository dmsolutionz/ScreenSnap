{
  "manifest_version": 3,
  "name": "screensnap.",
  "version": "1.1.0",
  "description": "Free, local, watermark-free screenshots and screen recording. Native MP4, all on your machine — no sign-up, no cloud, no upsell.",
  "minimum_chrome_version": "124",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "screensnap — capture & record",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "downloads",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "stop-recording": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Stop the screensnap recording"
    },
    "pause-recording": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause / resume the screensnap recording"
    },
    "restart-recording": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Restart the screensnap recording (discard and re-record)"
    },
    "cancel-recording": {
      "description": "Discard the screensnap recording (no save)"
    }
  }
}
